Fully automated conversion of groff manpages to MD.  Care is taken to
preserve copyright notices. This patch can be regenerated with the following script:

  mkdir orig; mv *.1 *.2 *.3 *.4 *.5 *.6 *.7 *.8 orig/
  for i in $(basename -a orig/*) ; do
  	sed -n '/\.\\"/p' <orig/$i > $i.md
  	sed -E '/.BI/ s/"//g' orig/$i | sed -E 's/^.BI(.*)/\1/' | \
  	pandoc -p --wrap=auto --columns=72 --standalone \
  	--lua-filter=indent-to-code.lua -f man -t markdown >> $i.md
  done
  rm -r orig

This the lua filter invoked above, required to fix the code blocks.  It
is the sole part of this patchset generated with AI:

  local function indent_content(text)
    local indented = "    " .. text
    indented = string.gsub(indented, "\n", "\n    ")
    return indented
  end

  function CodeBlock(elem)
    elem.text = indent_content(elem.text)
    elem.classes = { "text" }
    return elem
  end

  function Para(elem)
    if #elem.content < 1 then return nil end
    if elem.content[1].t == 'Str' then
      local text = elem.content[1].text
      if string.sub(text, 1, 4) == "    " then
        elem.content[1].text = string.sub(text, 5)
        local code_content = pandoc.utils.stringify(elem.content)
        local indented_content = indent_content(code_content)
        return pandoc.CodeBlock(indented_content, { "", { "text" }, {} })
      end
    end
  end

